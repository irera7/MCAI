<Page x:Class="ModelCreator.UI.Views.GenomicProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1200"
      Title="Genomic Project - پروژه ژنومی">

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,40">
                
                <!-- Header -->
                <TextBlock Text="🧬 Genomic Sequence Analysis" 
                          FontSize="32" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>
                
                <TextBlock Text="تحلیل سکانس ژنومی - DNA/RNA Classification" 
                          FontSize="16" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,40"/>
                
                <!-- Project Configuration -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Project Configuration" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Project Name:" Margin="0,0,0,8"/>
                        <TextBox x:Name="ProjectNameTextBox" 
                                Height="40" 
                                FontSize="14"
                                Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Sequence Type:" Margin="0,0,0,8"/>
                        <ComboBox x:Name="SequenceTypeComboBox" 
                                 Height="40" 
                                 FontSize="14"
                                 Margin="0,0,0,20">
                            <ComboBoxItem Content="DNA Sequences" IsSelected="True"/>
                            <ComboBoxItem Content="RNA Sequences"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                
                <!-- Model Selection -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Model Selection" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <RadioButton x:Name="DNA_CNNRadio" 
                                   Content="DNA CNN - 1D Convolutional Network for Sequences"
                                   GroupName="Models"
                                   IsChecked="True"
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Fast processing with one-hot encoding | پردازش سریع با کدگذاری one-hot" 
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="30,0,0,20"/>
                        
                        <RadioButton x:Name="SequenceEmbeddingRadio" 
                                   Content="Sequence Embedding - LSTM with Learned Representations"
                                   GroupName="Models"
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Better for complex patterns | بهتر برای الگوهای پیچیده" 
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="30,0,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Data Upload -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Upload FASTA Files" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Supported formats: .fasta, .fa, .fna, .ffn" 
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,15"/>
                        
                        <Button Content="📁 Upload FASTA Files" 
                               Style="{StaticResource PrimaryButton}"
                               Width="250"
                               Height="50"
                               Click="UploadDataButton_Click"
                               Margin="0,0,0,20"/>
                        
                        <TextBlock x:Name="DataStatusTextBlock" 
                                  Text="No data uploaded yet"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="14"/>
                    </StackPanel>
                </Border>
                
                <!-- Preprocessing Options -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Preprocessing Options" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Sequence Length:" Margin="0,0,0,8"/>
                                <ComboBox x:Name="SequenceLengthComboBox" Height="40">
                                    <ComboBoxItem Content="500"/>
                                    <ComboBoxItem Content="1000" IsSelected="True"/>
                                    <ComboBoxItem Content="2000"/>
                                    <ComboBoxItem Content="5000"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Encoding Type:" Margin="0,0,0,8"/>
                                <ComboBox x:Name="EncodingTypeComboBox" Height="40">
                                    <ComboBoxItem Content="One-Hot Encoding" IsSelected="True"/>
                                    <ComboBoxItem Content="Index Encoding"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Training Configuration -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Training Configuration" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Epochs:" Margin="0,0,0,8"/>
                                <ComboBox x:Name="EpochsComboBox" Height="40">
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="50" IsSelected="True"/>
                                    <ComboBoxItem Content="100"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Batch Size:" Margin="0,0,0,8"/>
                                <ComboBox x:Name="BatchSizeComboBox" Height="40">
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="16"/>
                                    <ComboBoxItem Content="32" IsSelected="True"/>
                                    <ComboBoxItem Content="64"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Start Training" 
                           Style="{StaticResource PrimaryButton}"
                           Width="200"
                           Height="50"
                           Click="StartTrainingButton_Click"
                           Margin="0,0,10,0"/>
                    
                    <Button Content="Cancel" 
                           Width="150"
                           Height="50"
                           Click="CancelButton_Click"/>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

