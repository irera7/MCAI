<Page x:Class="ModelCreator.UI.Views.TextProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Text Classification Project">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📝 Text Classification Project" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="Create and train text classification models" 
                       FontSize="14" Opacity="0.7" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Project Info -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Project Information" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name:" 
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProjectNameTextBox" 
                                     Margin="0,0,0,10" Padding="8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" 
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionTextBox" 
                                     Margin="0,0,0,10" Padding="8" Height="60" 
                                     TextWrapping="Wrap" AcceptsReturn="True"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Language:" 
                                       Margin="0,0,0,10"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LanguageComboBox" 
                                      Margin="0,0,0,10" Padding="8" SelectedIndex="0">
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="Persian (فارسی)"/>
                                <ComboBoxItem Content="Arabic (العربية)"/>
                                <ComboBoxItem Content="French"/>
                                <ComboBoxItem Content="Spanish"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data Upload -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Data Upload" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10">
                            Upload your text data in one of the following formats:
                            <LineBreak/>
                            • CSV file with 'text' and 'label' columns
                            <LineBreak/>
                            • JSON file with array of {text, label} objects
                            <LineBreak/>
                            • TXT files in class-named folders
                        </TextBlock>

                        <Button x:Name="UploadDataButton" 
                                Content="📁 Upload Text Data" 
                                Padding="15,10" 
                                Click="UploadDataButton_Click"
                                Background="{DynamicResource PrimaryBrush}" 
                                Foreground="White" 
                                FontWeight="SemiBold"
                                Cursor="Hand"/>

                        <TextBlock x:Name="DataStatusTextBlock" 
                                   Margin="0,10,0,0" 
                                   Foreground="Green" 
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Model Selection -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Model Selection" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <ItemsControl x:Name="TextModelsPanel">
                            <RadioButton x:Name="LSTMRadio" 
                                         Content="LSTM - Long Short-Term Memory" 
                                         GroupName="TextModels" 
                                         IsChecked="True" 
                                         Margin="0,0,0,10"/>
                            <TextBlock Text="Fast training, good for sequential data" 
                                       Opacity="0.7" Margin="25,0,0,15" FontSize="12"/>

                            <RadioButton x:Name="GRURadio" 
                                         Content="GRU - Gated Recurrent Unit" 
                                         GroupName="TextModels" 
                                         Margin="0,0,0,10"/>
                            <TextBlock Text="Similar to LSTM but faster" 
                                       Opacity="0.7" Margin="25,0,0,15" FontSize="12"/>

                            <RadioButton x:Name="TransformerRadio" 
                                         Content="Transformer - Attention-based" 
                                         GroupName="TextModels" 
                                         Margin="0,0,0,10"/>
                            <TextBlock Text="Modern architecture, best accuracy" 
                                       Opacity="0.7" Margin="25,0,0,15" FontSize="12"/>

                            <RadioButton x:Name="BERTRadio" 
                                         Content="BERT - Pre-trained Language Model" 
                                         GroupName="TextModels" 
                                         Margin="0,0,0,10"/>
                            <TextBlock Text="State-of-the-art, requires more resources" 
                                       Opacity="0.7" Margin="25,0,0,15" FontSize="12"/>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Training Configuration -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Training Configuration" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Max Sequence Length:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="MaxLengthComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="128 tokens"/>
                                    <ComboBoxItem Content="256 tokens"/>
                                    <ComboBoxItem Content="512 tokens"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Batch Size:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="BatchSizeComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="16"/>
                                    <ComboBoxItem Content="32"/>
                                    <ComboBoxItem Content="64"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,15,0,0">
                                <TextBlock Text="Learning Rate:" Margin="0,0,0,5"/>
                                <TextBox x:Name="LearningRateTextBox" Text="0.001" Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,15,0,0">
                                <TextBlock Text="Epochs:" Margin="0,0,0,5"/>
                                <TextBox x:Name="EpochsTextBox" Text="20" Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,15,0,0">
                                <TextBlock Text="Hidden Dimension:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="HiddenDimComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="128"/>
                                    <ComboBoxItem Content="256"/>
                                    <ComboBoxItem Content="512"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,15,0,0">
                                <TextBlock Text="Dropout:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DropoutComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="0.1"/>
                                    <ComboBoxItem Content="0.3"/>
                                    <ComboBoxItem Content="0.5"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CreateProjectButton" 
                            Content="✅ Create Text Project" 
                            Padding="20,12" 
                            Click="CreateProjectButton_Click"
                            Background="{DynamicResource SuccessBrush}" 
                            Foreground="White" 
                            FontSize="14" 
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,10,0"/>

                    <Button Content="❌ Cancel" 
                            Padding="20,12" 
                            Click="CancelButton_Click"
                            Background="{DynamicResource DangerBrush}" 
                            Foreground="White" 
                            FontSize="14"
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

