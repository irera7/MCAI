<Page x:Class="ModelCreator.UI.Views.CloudTrainingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cloud Training"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900">
                
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="☁️ " FontSize="32"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cloud Training" 
                                  FontSize="28" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Train your models on AWS, Azure, or Google Cloud" 
                                  FontSize="14" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Project Selection -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="1️⃣ Select Project" 
                                  FontSize="18" 
                                  FontWeight="SemiBold" 
                                  Margin="0,0,0,15"/>
                        <TextBlock Text="Choose a project to train in the cloud"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,10"/>
                        <ComboBox x:Name="ProjectComboBox"
                                 Height="40"
                                 FontSize="14"
                                 IsEditable="True"/>
                    </StackPanel>
                </Border>

                <!-- Cloud Provider Selection -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="2️⃣ Choose Cloud Provider" 
                                  FontSize="18" 
                                  FontWeight="SemiBold" 
                                  Margin="0,0,0,15"/>
                        
                        <RadioButton x:Name="AWSRadio"
                                    Content="Amazon Web Services (AWS)" 
                                    GroupName="Provider" 
                                    IsChecked="True" 
                                    Margin="0,0,0,12"
                                    FontSize="14"/>
                        <TextBlock Text="• SageMaker integration" 
                                  Margin="30,0,0,8" 
                                  FontSize="12" 
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        
                        <RadioButton x:Name="AzureRadio"
                                    Content="Microsoft Azure" 
                                    GroupName="Provider" 
                                    Margin="0,0,0,12"
                                    FontSize="14"/>
                        <TextBlock Text="• Azure ML integration" 
                                  Margin="30,0,0,8" 
                                  FontSize="12" 
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        
                        <RadioButton x:Name="GCPRadio"
                                    Content="Google Cloud Platform (GCP)" 
                                    GroupName="Provider"
                                    FontSize="14"/>
                        <TextBlock Text="• Vertex AI integration" 
                                  Margin="30,0,0,0" 
                                  FontSize="12" 
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Configuration -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="3️⃣ Configure Instance" 
                                  FontSize="18" 
                                  FontWeight="SemiBold" 
                                  Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Region:" Margin="0,0,0,8" FontSize="13"/>
                                <ComboBox x:Name="RegionComboBox" Height="40" FontSize="13">
                                    <ComboBoxItem Content="us-east-1" IsSelected="True"/>
                                    <ComboBoxItem Content="us-west-2"/>
                                    <ComboBoxItem Content="eu-west-1"/>
                                    <ComboBoxItem Content="ap-southeast-1"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Instance Type:" Margin="0,0,0,8" FontSize="13"/>
                                <ComboBox x:Name="InstanceTypeComboBox" 
                                         Height="40" 
                                         FontSize="13"
                                         SelectionChanged="InstanceTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="ml.p3.2xlarge (V100, 8GB)" IsSelected="True"/>
                                    <ComboBoxItem Content="ml.p3.8xlarge (4x V100, 32GB)"/>
                                    <ComboBoxItem Content="ml.p3.16xlarge (8x V100, 64GB)"/>
                                    <ComboBoxItem Content="ml.g4dn.xlarge (T4, 4GB)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Options -->
                        <StackPanel Margin="0,20,0,0">
                            <CheckBox x:Name="SpotInstanceCheckBox"
                                     Content="Use Spot/Preemptible Instances (Save up to 70%)"
                                     FontSize="13"
                                     Margin="0,0,0,10"
                                     Checked="SpotInstanceCheckBox_Changed"
                                     Unchecked="SpotInstanceCheckBox_Changed"/>
                            <CheckBox x:Name="AutoShutdownCheckBox"
                                     Content="Auto-shutdown when training completes"
                                     FontSize="13"
                                     IsChecked="True"/>
                        </StackPanel>

                        <!-- Cost Estimate -->
                        <Border Background="#FFF3E0"
                               BorderBrush="#FF9800"
                               BorderThickness="1"
                               CornerRadius="6"
                               Padding="15"
                               Margin="0,20,0,0">
                            <TextBlock x:Name="CostEstimateText"
                                      Text="💰 Estimated Cost: $3.06/hour"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="#E65100"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Start Button -->
                <Button x:Name="StartTrainingButton"
                       Content="🚀 Start Cloud Training"
                       Height="55"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Click="StartTrainingButton_Click"
                       Cursor="Hand"
                       Margin="0,0,0,20"/>

                <!-- Job Status Panel (Hidden by default) -->
                <Border x:Name="JobStatusPanel"
                       Style="{StaticResource Card}"
                       Padding="20"
                       Background="#E8F5E9"
                       BorderBrush="#4CAF50"
                       Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="✅ Cloud Training Job Started" 
                                  FontSize="16" 
                                  FontWeight="SemiBold"
                                  Foreground="#2E7D32"
                                  Margin="0,0,0,15"/>
                        <TextBlock x:Name="JobIdText"
                                  Text="Job ID: -"
                                  FontSize="13"
                                  Margin="0,0,0,8"/>
                        <TextBlock x:Name="JobStatusText"
                                  Text="Status: -"
                                  FontSize="13"
                                  Margin="0,0,0,8"/>
                        <TextBlock x:Name="EstimatedCostText"
                                  Text="Estimated Cost: -"
                                  FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Info Panel -->
                <Border Background="#E3F2FD"
                       BorderBrush="#2196F3"
                       BorderThickness="1"
                       CornerRadius="6"
                       Padding="20"
                       Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Cloud Training Benefits" 
                                  FontSize="15" 
                                  FontWeight="SemiBold"
                                  Foreground="#1976D2"
                                  Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#555">
                            <Run Text="• "/>
                            <Run Text="Access to powerful GPUs (V100, A100, T4)" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="• "/>
                            <Run Text="Faster training for large datasets" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="• "/>
                            <Run Text="Pay only for what you use" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="• "/>
                            <Run Text="Automatic scaling and management" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Note: " FontWeight="Bold" Foreground="#C62828"/>
                            <Run Text="Cloud credentials must be configured in backend settings." Foreground="#C62828"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
