<Page x:Class="ModelCreator.UI.Views.MedicalProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1200"
      Title="Medical Project - پروژه پزشکی">

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,40">
                
                <!-- Header -->
                <TextBlock Text="🏥 Medical Data Classification" 
                          FontSize="32" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>
                
                <TextBlock Text="دسته‌بندی داده‌های پزشکی - MRI, ECG, EEG" 
                          FontSize="16" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,40"/>
                
                <!-- Project Configuration -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Project Configuration" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Project Name:" Margin="0,0,0,8"/>
                        <TextBox x:Name="ProjectNameTextBox" 
                                Height="40" 
                                FontSize="14"
                                Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Data Type:" Margin="0,0,0,8"/>
                        <ComboBox x:Name="DataTypeComboBox" 
                                 Height="40" 
                                 FontSize="14"
                                 SelectionChanged="DataTypeComboBox_SelectionChanged"
                                 Margin="0,0,0,20">
                            <ComboBoxItem Content="MRI Images" IsSelected="True"/>
                            <ComboBoxItem Content="ECG Signals"/>
                            <ComboBoxItem Content="EEG Signals"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                
                <!-- Model Selection -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Model Selection" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <StackPanel x:Name="ModelSelectionPanel">
                            <RadioButton x:Name="MRI_CNNRadio" 
                                       Content="MRI CNN - شبکه عصبی برای MRI"
                                       GroupName="Models"
                                       IsChecked="True"
                                       Margin="0,0,0,10"/>
                            
                            <RadioButton x:Name="ECG_CNNRadio" 
                                       Content="ECG/EEG CNN - شبکه عصبی برای سیگنال‌ها"
                                       GroupName="Models"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Data Upload -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Upload Data" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <Button Content="📁 Upload Medical Files" 
                               Style="{StaticResource PrimaryButton}"
                               Width="250"
                               Height="50"
                               Click="UploadDataButton_Click"
                               Margin="0,0,0,20"/>
                        
                        <TextBlock x:Name="DataStatusTextBlock" 
                                  Text="No data uploaded yet"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="14"/>
                    </StackPanel>
                </Border>
                
                <!-- Training Configuration -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Training Configuration" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Epochs:" Margin="0,0,0,8"/>
                                <ComboBox x:Name="EpochsComboBox" Height="40">
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="50" IsSelected="True"/>
                                    <ComboBoxItem Content="100"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Batch Size:" Margin="0,0,0,8"/>
                                <ComboBox x:Name="BatchSizeComboBox" Height="40">
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="16"/>
                                    <ComboBoxItem Content="32" IsSelected="True"/>
                                    <ComboBoxItem Content="64"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Start Training" 
                           Style="{StaticResource PrimaryButton}"
                           Width="200"
                           Height="50"
                           Click="StartTrainingButton_Click"
                           Margin="0,0,10,0"/>
                    
                    <Button Content="Cancel" 
                           Width="150"
                           Height="50"
                           Click="CancelButton_Click"/>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

