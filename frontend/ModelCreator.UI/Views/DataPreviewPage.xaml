<Page x:Class="ModelCreator.UI.Views.DataPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Data Preview">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Data Preview and Statistics" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="Explore your dataset before training" 
                       FontSize="14" Opacity="0.7" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- File Selection -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Load Data File" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LoadFileButton" Content="Select File" 
                                    Padding="15,10" Margin="0,0,10,0"
                                    Click="LoadFileButton_Click"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FileNameText" Text="No file selected" 
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Statistics -->
                <Border x:Name="StatsPanel" Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Dataset Statistics" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total Samples -->
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" 
                                    CornerRadius="4" Padding="15" Margin="0,0,5,0" Background="#F5F5F5">
                                <StackPanel>
                                    <TextBlock Text="Total Samples" FontSize="12" Opacity="0.6"/>
                                    <TextBlock x:Name="TotalSamplesText" Text="0" 
                                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Features -->
                            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" 
                                    CornerRadius="4" Padding="15" Margin="0,0,5,0" Background="#F5F5F5">
                                <StackPanel>
                                    <TextBlock Text="Features" FontSize="12" Opacity="0.6"/>
                                    <TextBlock x:Name="FeaturesText" Text="0" 
                                               FontSize="24" FontWeight="Bold" Foreground="#2196F3"/>
                                </StackPanel>
                            </Border>

                            <!-- Classes -->
                            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" 
                                    CornerRadius="4" Padding="15" Margin="0,0,5,0" Background="#F5F5F5">
                                <StackPanel>
                                    <TextBlock Text="Classes" FontSize="12" Opacity="0.6"/>
                                    <TextBlock x:Name="ClassesText" Text="0" 
                                               FontSize="24" FontWeight="Bold" Foreground="#4CAF50"/>
                                </StackPanel>
                            </Border>

                            <!-- Missing Values -->
                            <Border Grid.Column="3" BorderBrush="#E0E0E0" BorderThickness="1" 
                                    CornerRadius="4" Padding="15" Background="#F5F5F5">
                                <StackPanel>
                                    <TextBlock Text="Missing Values" FontSize="12" Opacity="0.6"/>
                                    <TextBlock x:Name="MissingValuesText" Text="0" 
                                               FontSize="24" FontWeight="Bold" Foreground="#FF9800"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data Table -->
                <Border x:Name="TablePanel" Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Data Sample (First 10 rows)" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <DataGrid x:Name="DataPreviewGrid" 
                                  AutoGenerateColumns="True" 
                                  Height="250"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  CanUserResizeColumns="True"/>
                    </StackPanel>
                </Border>

                <!-- Class Distribution -->
                <Border x:Name="DistributionPanel" Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Class Distribution" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <ListView x:Name="ClassDistributionList" Height="150">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding ClassName}" 
                                                   FontWeight="SemiBold"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Percentage}" 
                                                     Maximum="100" Height="20" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Feature Info -->
                <Border x:Name="FeaturesPanel" Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Feature Information" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <DataGrid x:Name="FeatureInfoGrid" 
                                  AutoGenerateColumns="False" 
                                  Height="200"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Feature Name" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                                <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="80"/>
                                <DataGridTextColumn Header="Unique" Binding="{Binding Unique}" Width="80"/>
                                <DataGridTextColumn Header="Mean" Binding="{Binding Mean}" Width="100"/>
                                <DataGridTextColumn Header="Std" Binding="{Binding Std}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

