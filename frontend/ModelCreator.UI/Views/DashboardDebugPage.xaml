<Page x:Class="ModelCreator.UI.Views.DashboardDebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
      Title="Dashboard Debug">

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                
                <!-- Header -->
                <TextBlock Text="🔍 Training Dashboard Debug Tool" 
                          FontSize="28" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,20"/>
                
                <!-- Project ID Input -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Project ID:" 
                                  FontSize="16" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <TextBox x:Name="ProjectIdTextBox" 
                                FontFamily="Consolas"
                                FontSize="14"
                                Height="40"
                                Padding="10"
                                Margin="0,0,0,20"/>
                        
                        <Button Content="🔄 Test API" 
                               Style="{StaticResource PrimaryButton}"
                               Width="200"
                               Height="50"
                               HorizontalAlignment="Left"
                               Click="TestButton_Click"/>
                    </StackPanel>
                </Border>
                
                <!-- Status -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="StatusTextBlock"
                                  Text="⏸️ آماده برای تست"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Status:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="StatusValueText" Text="-" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Epoch:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="EpochValueText" Text="-" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="10,0">
                                <TextBlock Text="Loss:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LossValueText" Text="-" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="Accuracy:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="AccValueText" Text="-" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Raw Response -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📄 API Response (JSON)" 
                                      FontSize="16" 
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            <Button Content="📋 Copy" 
                                   Margin="20,0,0,0"
                                   Padding="15,5"
                                   Click="CopyButton_Click"/>
                        </StackPanel>
                        
                        <Border BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="4"
                               Padding="10"
                               Background="#F5F5F5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="400">
                                <TextBox x:Name="ResponseTextBox"
                                        IsReadOnly="True"
                                        TextWrapping="Wrap"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="#333"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>
                
                <!-- Instructions -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📖 راهنما" 
                                  FontSize="16" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,15"/>
                        
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="1. Project ID را وارد کنید (از Backend logs یا database)"/>
                            <LineBreak/>
                            <Run Text="2. دکمه 'Test API' را کلیک کنید"/>
                            <LineBreak/>
                            <Run Text="3. JSON response را بررسی کنید"/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="✅ اگر status='training' و current_epoch وجود داشت → API کار می‌کند"/>
                            <LineBreak/>
                            <Run Text="❌ اگر status='not_started' → Training شروع نشده یا Project ID اشتباه است"/>
                            <LineBreak/>
                            <Run Text="❌ اگر خطا دریافت کردید → Backend در حال اجرا نیست"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Back Button -->
                <Button Content="← بازگشت" 
                       Width="150"
                       Height="45"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Left"
                       Click="BackButton_Click"/>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

