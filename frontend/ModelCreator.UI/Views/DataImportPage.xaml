<Page x:Class="ModelCreator.UI.Views.DataImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Data Import">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Main Import Area -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <TextBlock Text="Import &amp; لیبل‌گذاری داده‌ها" 
                          FontSize="32" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,10"/>
                
                <TextBlock x:Name="ProjectDescText"
                          Text="پروژه: مدل من | نوع: Image Classification" 
                          FontSize="14" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="📌 راهنما: ابتدا لیبل‌ها را از سمت راست اضافه کنید، سپس فایل‌ها را import و لیبل‌گذاری کنید" 
                          FontSize="13" 
                          Foreground="{StaticResource SecondaryBrush}"
                          TextWrapping="Wrap"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="💡 Import CSV: برای لیبل‌گذاری خودکار، فایل CSV با فرمت (filename,label) آماده کنید" 
                          FontSize="12" 
                          Foreground="{StaticResource AccentBrush}"
                          TextWrapping="Wrap"
                          Margin="0,0,0,20"/>
                
                <!-- Drop Zone -->
                <Border Style="{StaticResource Card}"
                       AllowDrop="True"
                       Drop="DropZone_Drop"
                       DragEnter="DropZone_DragEnter"
                       DragLeave="DropZone_DragLeave"
                       Background="{StaticResource BackgroundBrush}"
                       MinHeight="250">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📁" 
                                  FontSize="64" 
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="فایل‌ها یا فولدرها را اینجا رها کنید" 
                                  FontSize="24" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,20,0,10"/>
                        <TextBlock Text="پشتیبانی: تصاویر، صوت، ویدیو، CSV، فایل‌های متنی" 
                                  FontSize="14" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📄 انتخاب فایل‌ها" 
                                   Style="{StaticResource PrimaryButton}"
                                   Width="140"
                                   Height="45"
                                   Margin="0,0,5,0"
                                   Click="BrowseFiles_Click"/>
                            <Button Content="📁 انتخاب فولدر" 
                                   Style="{StaticResource PrimaryButton}"
                                   Width="140"
                                   Height="45"
                                   Margin="5,0,5,0"
                                   Click="BrowseFolder_Click"/>
                            <Button Content="📊 Import CSV" 
                                   Style="{StaticResource PrimaryButton}"
                                   Width="140"
                                   Height="45"
                                   Margin="5,0,0,0"
                                   ToolTip="لیبل‌گذاری خودکار از فایل CSV"
                                   Click="ImportCSV_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Data Preview -->
                <TextBlock Text="فایل‌های Import شده" 
                          FontSize="20" 
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,30,0,15"/>
                
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock x:Name="DataCountText"
                                      Text="0 فایل import شده" 
                                      FontSize="14" 
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Content="پاک کردن همه" 
                                   HorizontalAlignment="Right"
                                   Width="100"
                                   Click="ClearAll_Click"/>
                        </Grid>
                        
                        <TextBlock Text="💡 نکته: از منوی کشویی در هر ردیف برای انتخاب لیبل استفاده کنید"
                                  FontSize="11"
                                  Foreground="{StaticResource AccentBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,10"/>
                        
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="DataListBox" 
                                    BorderThickness="0"
                                    Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                               BorderThickness="0,0,0,1"
                                               Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0"
                                                          Text="📄" 
                                                          FontSize="20"
                                                          Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1"
                                                          Text="{Binding FileName}" 
                                                          FontSize="14"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2"
                                                         ItemsSource="{Binding DataContext.Labels, RelativeSource={RelativeSource AncestorType=Page}}"
                                                         SelectedItem="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="180"
                                                         Height="30"
                                                         Margin="10,0"
                                                         SelectionChanged="LabelComboBox_SelectionChanged"
                                                         Tag="{Binding}"/>
                                                <Button Grid.Column="3"
                                                       Content="✕" 
                                                       Width="30"
                                                       Height="30"
                                                       FontSize="16"
                                                       Click="RemoveItem_Click"
                                                       Tag="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Right Panel - Labels & Actions -->
        <Border Grid.Column="1" 
               Background="{StaticResource SurfaceBrush}"
               BorderBrush="{StaticResource BorderBrush}"
               BorderThickness="1,0,0,0"
               Padding="30">
            <StackPanel>
                <TextBlock Text="لیبل‌های کلاس" 
                          FontSize="20" 
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,20"/>
                
                <!-- Add Label -->
                <Border Style="{StaticResource Card}" Padding="15">
                    <StackPanel>
                        <TextBlock Text="➕ افزودن لیبل جدید" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="مثال: گربه، سگ، پرنده" 
                                  FontSize="11" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,10"/>
                        <TextBox x:Name="NewLabelTextBox" 
                                Height="35" 
                                FontSize="14"
                                Margin="0,0,0,10"/>
                        <Button Content="➕ افزودن" 
                               Style="{StaticResource PrimaryButton}"
                               Height="35"
                               Click="AddLabel_Click"/>
                    </StackPanel>
                </Border>
                
                <!-- Labels List -->
                <TextBlock Text="Current Labels" 
                          FontSize="14" 
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,20,0,10"/>
                
                <ListBox x:Name="LabelsListBox" 
                        BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush}"
                        MaxHeight="250">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                          Text="{Binding Name}" 
                                          FontSize="14"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="5,0"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding Count}" 
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="10,0"/>
                                <Button Grid.Column="2"
                                       Content="✕" 
                                       Width="25"
                                       Height="25"
                                       FontSize="12"
                                       Click="RemoveLabel_Click"
                                       Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- Statistics -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Data Statistics" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                      Text="Total Samples:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                      x:Name="TotalSamplesText"
                                      Text="0" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                      Text="Labeled:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                      x:Name="LabeledSamplesText"
                                      Text="0" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource AccentBrush}"
                                      Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                      Text="Unlabeled:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                      x:Name="UnlabeledSamplesText"
                                      Text="0" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource SecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Navigation Buttons -->
                <StackPanel Margin="0,30,0,0">
                    <Button Content="Back" 
                           Height="45"
                           Margin="0,0,0,10"
                           Click="Back_Click"/>
                    <Button Content="Next: Select Model →" 
                           Style="{StaticResource PrimaryButton}"
                           Height="50"
                           FontSize="16"
                           Click="Next_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

