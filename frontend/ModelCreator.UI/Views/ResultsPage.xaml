<Page x:Class="ModelCreator.UI.Views.ResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Training Results">

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                
                <!-- Header -->
                <Grid Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="🎉 Training Complete!" 
                                  FontSize="36" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="ProjectNameText"
                                  Text="Project: My Model" 
                                  FontSize="14" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
                
                <!-- Performance Summary -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📊 Performance Summary" 
                                  FontSize="24" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Final Accuracy -->
                            <Border Grid.Column="0" 
                                   Background="{StaticResource BackgroundBrush}"
                                   CornerRadius="8"
                                   Padding="20"
                                   Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Final Accuracy" 
                                              FontSize="12" 
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="FinalAccuracyText"
                                              Text="95.67%" 
                                              FontSize="32" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource AccentBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Final Loss -->
                            <Border Grid.Column="1" 
                                   Background="{StaticResource BackgroundBrush}"
                                   CornerRadius="8"
                                   Padding="20"
                                   Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Final Loss" 
                                              FontSize="12" 
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="FinalLossText"
                                              Text="0.1234" 
                                              FontSize="32" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource PrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Training Time -->
                            <Border Grid.Column="2" 
                                   Background="{StaticResource BackgroundBrush}"
                                   CornerRadius="8"
                                   Padding="20"
                                   Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Training Time" 
                                              FontSize="12" 
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TrainingTimeText"
                                              Text="18m 42s" 
                                              FontSize="32" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource SecondaryBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Total Epochs -->
                            <Border Grid.Column="3" 
                                   Background="{StaticResource BackgroundBrush}"
                                   CornerRadius="8"
                                   Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Epochs Trained" 
                                              FontSize="12" 
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EpochsTrainedText"
                                              Text="50" 
                                              FontSize="32" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Per-Class Metrics -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📈 Per-Class Performance" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,15"/>
                        
                        <DataGrid x:Name="ClassMetricsGrid"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HeadersVisibility="Column"
                                 GridLinesVisibility="Horizontal"
                                 CanUserResizeColumns="True"
                                 CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Class" 
                                                   Binding="{Binding ClassName}" 
                                                   Width="*"
                                                   FontSize="14"/>
                                <DataGridTextColumn Header="Precision" 
                                                   Binding="{Binding Precision, StringFormat={}{0:P2}}" 
                                                   Width="120"
                                                   FontSize="14"/>
                                <DataGridTextColumn Header="Recall" 
                                                   Binding="{Binding Recall, StringFormat={}{0:P2}}" 
                                                   Width="120"
                                                   FontSize="14"/>
                                <DataGridTextColumn Header="F1-Score" 
                                                   Binding="{Binding F1Score, StringFormat={}{0:P2}}" 
                                                   Width="120"
                                                   FontSize="14"/>
                                <DataGridTextColumn Header="Samples" 
                                                   Binding="{Binding SampleCount}" 
                                                   Width="100"
                                                   FontSize="14"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                
                <!-- Model Export -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📤 Export Model" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Select export formats and location:" 
                                  FontSize="14" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,15"/>
                        
                        <!-- Export Format Selection -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <CheckBox x:Name="ExportPyTorchCheckBox"
                                         Content="PyTorch (.pt) - Native format" 
                                         FontSize="14"
                                         IsChecked="True"
                                         Margin="0,0,0,10"/>
                                <CheckBox x:Name="ExportONNXCheckBox"
                                         Content="ONNX (.onnx) - Universal format" 
                                         FontSize="14"
                                         IsChecked="True"
                                         Margin="0,0,0,10"/>
                                <CheckBox x:Name="ExportTFLiteCheckBox"
                                         Content="TensorFlow Lite (.tflite) - Mobile" 
                                         FontSize="14"
                                         IsChecked="False"
                                         Margin="0,0,0,10"/>
                                <CheckBox x:Name="IncludeMetadataCheckBox"
                                         Content="Include metadata and instructions" 
                                         FontSize="14"
                                         IsChecked="True"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Export Location:" 
                                          FontSize="14" 
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="ExportPathTextBox"
                                            Grid.Column="0"
                                            Height="40"
                                            FontSize="14"
                                            IsReadOnly="True"
                                            Text="Select export folder..."
                                            VerticalContentAlignment="Center"
                                            Margin="0,0,10,0"/>
                                    <Button Grid.Column="1"
                                           Content="Browse..."
                                           Width="100"
                                           Height="40"
                                           Click="BrowseExportPath_Click"/>
                                </Grid>
                                
                                <Button x:Name="ExportButton"
                                       Content="📦 Export Model" 
                                       Style="{StaticResource PrimaryButton}"
                                       Height="50"
                                       FontSize="16"
                                       Margin="0,20,0,0"
                                       Click="Export_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Next Steps -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🚀 Next Steps" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0"
                                   Content="🎮 Test in Playground" 
                                   Height="60"
                                   FontSize="14"
                                   Margin="0,0,10,0"
                                   Click="TestInPlayground_Click"/>
                            
                            <Button Grid.Column="1"
                                   Content="📊 View Training Dashboard" 
                                   Height="60"
                                   FontSize="14"
                                   Margin="0,0,10,0"
                                   Click="ViewDashboard_Click"/>
                            
                            <Button Grid.Column="2"
                                   Content="🏠 Back to Home" 
                                   Height="60"
                                   FontSize="14"
                                   Click="BackToHome_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

