<Page x:Class="ModelCreator.UI.Views.AudioProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Audio Classification Project">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🎵 Audio Classification Project" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="Create and train audio classification models" 
                       FontSize="14" Opacity="0.7" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Project Info -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Project Information" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name:" 
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProjectNameTextBox" 
                                     Margin="0,0,0,10" Padding="8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" 
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionTextBox" 
                                     Margin="0,0,0,10" Padding="8" Height="60" 
                                     TextWrapping="Wrap" AcceptsReturn="True"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Audio Type:" 
                                       Margin="0,0,0,10"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AudioTypeComboBox" 
                                      Margin="0,0,0,10" Padding="8" SelectedIndex="0">
                                <ComboBoxItem Content="Speech / Voice"/>
                                <ComboBoxItem Content="Music"/>
                                <ComboBoxItem Content="Environmental Sounds"/>
                                <ComboBoxItem Content="Animal Sounds"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data Upload -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Data Upload" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10">
                            Upload your audio data in one of the following formats:
                            <LineBreak/>
                            • Folder with class subfolders (e.g., class1/*.wav, class2/*.wav)
                            <LineBreak/>
                            • Supported formats: .wav, .mp3, .flac
                            <LineBreak/>
                            • Recommended: 16kHz or 22kHz sample rate
                        </TextBlock>

                        <Button x:Name="UploadDataButton" 
                                Content="📁 Upload Audio Files" 
                                Padding="15,10" 
                                Click="UploadDataButton_Click"
                                Background="{DynamicResource PrimaryBrush}" 
                                Foreground="White" 
                                FontWeight="SemiBold"
                                Cursor="Hand"/>

                        <TextBlock x:Name="DataStatusTextBlock" 
                                   Margin="0,10,0,0" 
                                   Foreground="Green" 
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Model Selection -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Model Selection" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <RadioButton x:Name="SpectrogramCNNRadio" 
                                     Content="Spectrogram CNN" 
                                     GroupName="AudioModels" 
                                     IsChecked="True" 
                                     Margin="0,0,0,10"/>
                        <TextBlock Text="Converts audio to mel spectrograms and uses CNN for classification" 
                                   Opacity="0.7" Margin="25,0,0,15" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Audio Preprocessing Config -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Audio Preprocessing" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Sample Rate:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="SampleRateComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="16000 Hz"/>
                                    <ComboBoxItem Content="22050 Hz"/>
                                    <ComboBoxItem Content="44100 Hz"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Audio Duration:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DurationComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="1 second"/>
                                    <ComboBoxItem Content="3 seconds"/>
                                    <ComboBoxItem Content="5 seconds"/>
                                    <ComboBoxItem Content="10 seconds"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,15,0,0">
                                <TextBlock Text="N_Mels (Frequency Bands):" Margin="0,0,0,5"/>
                                <ComboBox x:Name="NMelsComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="64"/>
                                    <ComboBoxItem Content="128"/>
                                    <ComboBoxItem Content="256"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Training Configuration -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Training Configuration" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Batch Size:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="BatchSizeComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="16"/>
                                    <ComboBoxItem Content="32"/>
                                    <ComboBoxItem Content="64"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Learning Rate:" Margin="0,0,0,5"/>
                                <TextBox x:Name="LearningRateTextBox" Text="0.001" Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,15,0,0">
                                <TextBlock Text="Epochs:" Margin="0,0,0,5"/>
                                <TextBox x:Name="EpochsTextBox" Text="30" Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,15,0,0">
                                <TextBlock Text="Dropout:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DropoutComboBox" SelectedIndex="1" Padding="8">
                                    <ComboBoxItem Content="0.1"/>
                                    <ComboBoxItem Content="0.3"/>
                                    <ComboBoxItem Content="0.5"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CreateProjectButton" 
                            Content="✅ Create Audio Project" 
                            Padding="20,12" 
                            Click="CreateProjectButton_Click"
                            Background="{DynamicResource SuccessBrush}" 
                            Foreground="White" 
                            FontSize="14" 
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,10,0"/>

                    <Button Content="❌ Cancel" 
                            Padding="20,12" 
                            Click="CancelButton_Click"
                            Background="{DynamicResource DangerBrush}" 
                            Foreground="White" 
                            FontSize="14"
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

