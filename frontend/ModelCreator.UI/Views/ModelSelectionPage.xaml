<Page x:Class="ModelCreator.UI.Views.ModelSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Model Selection">

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <TextBlock Text="Select Model Architecture" 
                          FontSize="32" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="Choose a pre-configured model architecture for your data type" 
                          FontSize="14" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,30"/>
                
                <!-- Model Cards Grid -->
                <ItemsControl x:Name="ModelsGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" 
                                   Background="{Binding IsSelected, Converter={StaticResource SelectionConverter}}"
                                   BorderBrush="{Binding IsSelected, Converter={StaticResource SelectionBorderConverter}}"
                                   BorderThickness="2"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="ModelCard_Click"
                                   Tag="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header -->
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" 
                                                      FontSize="32" 
                                                      Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" 
                                                          FontSize="20" 
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Category}" 
                                                          FontSize="12" 
                                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Background="{StaticResource AccentBrush}"
                                               CornerRadius="3"
                                               Padding="8,4"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="⭐ Recommended" 
                                                      FontSize="10" 
                                                      Foreground="White"
                                                      FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Description -->
                                    <TextBlock Grid.Row="1"
                                              Text="{Binding Description}" 
                                              FontSize="13" 
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              TextWrapping="Wrap"
                                              Margin="0,15,0,15"/>
                                    
                                    <!-- Metrics -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Speed" 
                                                      FontSize="11" 
                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ProgressBar Value="{Binding Speed}" 
                                                        Maximum="5" 
                                                        Height="8" 
                                                        Margin="0,5,10,0"
                                                        Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Accuracy" 
                                                      FontSize="11" 
                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ProgressBar Value="{Binding Accuracy}" 
                                                        Maximum="5" 
                                                        Height="8" 
                                                        Margin="0,5,10,0"
                                                        Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Memory" 
                                                      FontSize="11" 
                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ProgressBar Value="{Binding Memory}" 
                                                        Maximum="5" 
                                                        Height="8" 
                                                        Margin="0,5,0,0"
                                                        Foreground="{StaticResource SecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Details -->
                                    <Border Grid.Row="3" 
                                           Background="{StaticResource BackgroundBrush}"
                                           CornerRadius="4"
                                           Padding="10"
                                           Margin="0,15,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Training Time" 
                                                          FontSize="10" 
                                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding TrainingTime}" 
                                                          FontSize="12" 
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Parameters" 
                                                          FontSize="10" 
                                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Parameters}" 
                                                          FontSize="12" 
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Navigation Buttons -->
                <Grid Margin="0,30,0,0">
                    <Button Content="← Back" 
                           Height="50"
                           Width="150"
                           HorizontalAlignment="Left"
                           Click="Back_Click"/>
                    <Button x:Name="NextButton"
                           Content="Next: Configure Training →" 
                           Style="{StaticResource PrimaryButton}"
                           Height="50"
                           Width="250"
                           FontSize="16"
                           HorizontalAlignment="Right"
                           IsEnabled="False"
                           Click="Next_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

