<Page x:Class="ModelCreator.UI.Views.EnsembleMethodsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ensemble Methods"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200">
                
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="🎯 " FontSize="32"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ensemble Methods" 
                                  FontSize="28" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Combine multiple trained models for improved accuracy" 
                                  FontSize="14" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                           Content="🔄 Refresh"
                           Width="100"
                           Height="35"
                           Margin="20,0,0,0"
                           Click="RefreshButton_Click"
                           VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Loading Panel -->
                <Border x:Name="LoadingPanel"
                       Style="{StaticResource Card}"
                       Padding="40"
                       HorizontalAlignment="Center"
                       Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Loading available models..." 
                                  FontSize="16" 
                                  Margin="0,10,0,0"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Error Panel -->
                <Border x:Name="ErrorPanel"
                       Style="{StaticResource Card}"
                       Padding="30"
                       Background="#FEE"
                       BorderBrush="#F88"
                       Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ErrorText"
                                  FontSize="14"
                                  TextWrapping="Wrap"
                                  Foreground="#C00"/>
                        <Button Content="🔄 Retry"
                               Width="120"
                               Margin="0,15,0,0"
                               Click="RefreshButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Main Content -->
                <StackPanel x:Name="ModelsPanel" Visibility="Collapsed">
                    
                    <!-- Status Bar -->
                    <Border Style="{StaticResource Card}" 
                           Padding="15"
                           Margin="0,0,0,15"
                           Background="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StatusText"
                                      Text="Loading models..."
                                      FontSize="13"
                                      Foreground="White"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Model Selection -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="1️⃣ Select Models to Ensemble" 
                                      FontSize="18" 
                                      FontWeight="SemiBold" 
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Select at least 2 trained models with the same number of classes"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,15"/>
                            
                            <ListBox x:Name="ModelsListBox"
                                    SelectionMode="Multiple"
                                    Height="200"
                                    SelectionChanged="ModelsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8"
                                               Background="{StaticResource CardBackgroundBrush}"
                                               Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ProjectName}" 
                                                              FontWeight="SemiBold"
                                                              FontSize="13"/>
                                                    <TextBlock FontSize="11"
                                                              Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Architecture}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding Modality}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding NumClasses}"/>
                                                        <Run Text=" classes"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <Border Grid.Column="1"
                                                       Background="{StaticResource SuccessBrush}"
                                                       CornerRadius="4"
                                                       Padding="8,4"
                                                       VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" 
                                                              FontWeight="Bold"
                                                              Foreground="White">
                                                        <Run Text="{Binding Accuracy, StringFormat='{}{0:F1}%'}"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Selection Status -->
                            <Border Padding="10"
                                   Margin="0,10,0,0"
                                   Background="#F5F5F5"
                                   CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SelectedCountText"
                                              Text="0 models selected"
                                              FontSize="12"
                                              Margin="0,0,15,0"/>
                                    <TextBlock x:Name="ValidationText"
                                              Text="⚠️ Select at least 2 models"
                                              FontSize="12"
                                              Foreground="Orange"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Ensemble Configuration -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="2️⃣ Configure Ensemble" 
                                      FontSize="18" 
                                      FontWeight="SemiBold" 
                                      Margin="0,0,0,15"/>

                            <!-- Ensemble Name -->
                            <TextBlock Text="Ensemble Name" FontSize="13" Margin="0,0,0,8"/>
                            <TextBox x:Name="EnsembleNameTextBox"
                                    Height="35"
                                    Margin="0,0,0,20"
                                    VerticalContentAlignment="Center"
                                    Text="My Ensemble Model"/>

                            <!-- Ensemble Type -->
                            <TextBlock Text="Ensemble Method" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            
                            <RadioButton x:Name="VotingRadio" 
                                        Content="Voting Ensemble" 
                                        GroupName="Ensemble" 
                                        IsChecked="True" 
                                        Margin="0,0,0,8"/>
                            <TextBlock Text="• Combines predictions by voting (recommended for most cases)" 
                                      Opacity="0.7" 
                                      Margin="25,0,0,12" 
                                      FontSize="11"/>

                            <RadioButton x:Name="StackingRadio" 
                                        Content="Stacking Ensemble" 
                                        GroupName="Ensemble" 
                                        Margin="0,0,0,8"/>
                            <TextBlock Text="• Trains a meta-model on base model predictions (advanced)" 
                                      Opacity="0.7" 
                                      Margin="25,0,0,12" 
                                      FontSize="11"/>

                            <RadioButton x:Name="BaggingRadio" 
                                        Content="Bagging Ensemble" 
                                        GroupName="Ensemble" 
                                        Margin="0,0,0,8"/>
                            <TextBlock Text="• Averages predictions from multiple models" 
                                      Opacity="0.7" 
                                      Margin="25,0,0,15" 
                                      FontSize="11"/>

                            <!-- Voting Type (for Voting Ensemble) -->
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="15"
                                   Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Voting Strategy (for Voting Ensemble)" 
                                              FontSize="13" 
                                              FontWeight="SemiBold" 
                                              Margin="0,0,0,10"/>
                                    <RadioButton Content="Soft Voting (Average probabilities - recommended)" 
                                                GroupName="VotingType" 
                                                IsChecked="True" 
                                                Margin="0,0,0,8"
                                                FontSize="12"/>
                                    <RadioButton x:Name="HardVotingRadio"
                                                Content="Hard Voting (Majority vote)" 
                                                GroupName="VotingType"
                                                FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Create Button -->
                    <Button x:Name="CreateEnsembleButton" 
                           Content="🎯 Create Ensemble" 
                           Height="50"
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Click="CreateEnsembleButton_Click"
                           IsEnabled="False"
                           Cursor="Hand"/>

                    <!-- Info Box -->
                    <Border Background="#E3F2FD"
                           BorderBrush="#2196F3"
                           BorderThickness="1"
                           CornerRadius="6"
                           Padding="15"
                           Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 How Ensemble Works" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"
                                      Foreground="#1976D2"
                                      Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555">
                                <Run Text="Ensemble methods combine multiple trained models to achieve better accuracy than any single model."/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="• " FontWeight="Bold"/>
                                <Run Text="Voting: Each model votes on the prediction"/>
                                <LineBreak/>
                                <Run Text="• " FontWeight="Bold"/>
                                <Run Text="Stacking: A meta-model learns to combine predictions"/>
                                <LineBreak/>
                                <Run Text="• " FontWeight="Bold"/>
                                <Run Text="Bagging: Averages predictions to reduce variance"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
