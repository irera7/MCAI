<Page x:Class="ModelCreator.UI.Views.InferencePlaygroundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Inference Playground">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Padding="30,20">
            <StackPanel>
                <TextBlock Text="Inference Playground" 
                          FontSize="28" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Test your trained model with new data" 
                          FontSize="14" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="30,0,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Input Section -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Input" 
                              FontSize="20" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,20"/>
                    
                    <!-- Upload Area -->
                    <Border Background="{StaticResource BackgroundBrush}"
                           BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="2"
                           CornerRadius="8"
                           Height="300"
                           AllowDrop="True"
                           Drop="InputArea_Drop"
                           DragEnter="InputArea_DragEnter"
                           DragLeave="InputArea_DragLeave">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" 
                                      FontSize="48" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Drag &amp; drop file here" 
                                      FontSize="16" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,0"/>
                            <TextBlock Text="or" 
                                      FontSize="14" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,10"/>
                            <Button Content="Browse Files" 
                                   Style="{StaticResource PrimaryButton}"
                                   Click="BrowseFiles_Click"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Preview Area -->
                    <Border Margin="0,20,0,0"
                           BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="4"
                           Height="200">
                        <Grid>
                            <Image x:Name="PreviewImage" 
                                  Stretch="Uniform"
                                  Visibility="Collapsed"/>
                            <TextBlock x:Name="PreviewText"
                                      TextWrapping="Wrap"
                                      Padding="10"
                                      VerticalAlignment="Top"
                                      Visibility="Collapsed"/>
                            <TextBlock x:Name="PreviewPlaceholder"
                                      Text="Preview will appear here"
                                      FontSize="14"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Predict Button -->
                    <Button x:Name="PredictButton"
                           Content="🚀 Run Prediction" 
                           Style="{StaticResource PrimaryButton}"
                           Height="50"
                           FontSize="16"
                           Margin="0,20,0,0"
                           IsEnabled="False"
                           Click="Predict_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Results Section -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Results" 
                              FontSize="20" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,20"/>
                    
                    <!-- Prediction Result -->
                    <Border Background="{StaticResource BackgroundBrush}"
                           BorderBrush="{StaticResource PrimaryBrush}"
                           BorderThickness="2"
                           CornerRadius="8"
                           Padding="20"
                           Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Predicted Class" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="PredictedClassText"
                                      Text="—" 
                                      FontSize="28" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource PrimaryBrush}"
                                      Margin="0,5,0,10"/>
                            <ProgressBar x:Name="ConfidenceBar"
                                        Height="12" 
                                        Value="0" 
                                        Maximum="100"
                                        Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ConfidenceText"
                                      Text="Confidence: —" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Top Predictions -->
                    <TextBlock Text="Top 5 Predictions" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,10"/>
                    
                    <ItemsControl x:Name="TopPredictionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                       CornerRadius="4"
                                       Padding="10"
                                       Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0"
                                                  Text="{Binding Label}" 
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Probability, StringFormat={}{0:P1}}" 
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="{StaticResource AccentBrush}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Inference Time -->
                    <Border Background="{StaticResource BackgroundBrush}"
                           CornerRadius="4"
                           Padding="10"
                           Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ Inference Time: " 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="InferenceTimeText"
                                      Text="—" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

