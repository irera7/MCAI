<Page x:Class="ModelCreator.UI.Views.TrainingConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Training Configuration">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Main Settings Area -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <TextBlock Text="Training Configuration" 
                          FontSize="32" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="Configure hyperparameters and training settings" 
                          FontSize="14" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,30"/>
                
                <!-- Basic Settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="⚙️ Basic Settings" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <!-- Epochs -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Number of Epochs" 
                                          FontSize="14" 
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Complete passes through the training data" 
                                          FontSize="11" 
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,2,0,8"/>
                                <Slider x:Name="EpochsSlider" 
                                       Minimum="10" 
                                       Maximum="200" 
                                       Value="50"
                                       TickFrequency="10"
                                       IsSnapToTickEnabled="True"
                                       ValueChanged="EpochsSlider_ValueChanged"/>
                            </StackPanel>
                            
                            <TextBox x:Name="EpochsTextBox" 
                                    Grid.Column="1"
                                    Text="50" 
                                    Height="35"
                                    FontSize="16"
                                    TextAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    TextChanged="EpochsTextBox_TextChanged"/>
                        </Grid>
                        
                        <!-- Batch Size -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Batch Size" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Number of samples per training batch" 
                                      FontSize="11" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,2,0,8"/>
                            <ComboBox x:Name="BatchSizeComboBox" 
                                     Height="40" 
                                     FontSize="14"
                                     SelectedIndex="2">
                                <ComboBoxItem Content="8 (Very small datasets)"/>
                                <ComboBoxItem Content="16 (Small datasets)"/>
                                <ComboBoxItem Content="32 (Recommended)"/>
                                <ComboBoxItem Content="64 (Large datasets, GPU required)"/>
                                <ComboBoxItem Content="128 (Very large datasets, powerful GPU)"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Learning Rate -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Learning Rate" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Step size for model updates" 
                                      FontSize="11" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,2,0,8"/>
                            <ComboBox x:Name="LearningRateComboBox" 
                                     Height="40" 
                                     FontSize="14"
                                     SelectedIndex="2">
                                <ComboBoxItem Content="0.0001 (Very conservative)"/>
                                <ComboBoxItem Content="0.0005 (Conservative)"/>
                                <ComboBoxItem Content="0.001 (Recommended)"/>
                                <ComboBoxItem Content="0.005 (Aggressive)"/>
                                <ComboBoxItem Content="0.01 (Very aggressive)"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Optimizer -->
                        <StackPanel>
                            <TextBlock Text="Optimizer" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Algorithm for updating model weights" 
                                      FontSize="11" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,2,0,8"/>
                            <ComboBox x:Name="OptimizerComboBox" 
                                     Height="40" 
                                     FontSize="14"
                                     SelectedIndex="0">
                                <ComboBoxItem Content="Adam (Recommended - Most versatile)"/>
                                <ComboBoxItem Content="AdamW (Adam with weight decay)"/>
                                <ComboBoxItem Content="SGD (Stochastic Gradient Descent)"/>
                                <ComboBoxItem Content="RMSprop (Good for RNNs)"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Advanced Settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🔧 Advanced Settings" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <!-- Data Split -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Train Split %" 
                                          FontSize="12" 
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TrainSplitTextBox" 
                                        Text="70" 
                                        Height="35"
                                        TextAlignment="Center"
                                        Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Validation Split %" 
                                          FontSize="12" 
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="ValSplitTextBox" 
                                        Text="20" 
                                        Height="35"
                                        TextAlignment="Center"
                                        Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Test Split %" 
                                          FontSize="12" 
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TestSplitTextBox" 
                                        Text="10" 
                                        Height="35"
                                        TextAlignment="Center"
                                        Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Dropout -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dropout Rate" 
                                          FontSize="14" 
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Regularization to prevent overfitting (0.0 - 0.5)" 
                                          FontSize="11" 
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,2,0,8"/>
                                <Slider x:Name="DropoutSlider" 
                                       Minimum="0" 
                                       Maximum="0.5" 
                                       Value="0.2"
                                       TickFrequency="0.05"
                                       IsSnapToTickEnabled="True"
                                       ValueChanged="DropoutSlider_ValueChanged"/>
                            </StackPanel>
                            
                            <TextBox x:Name="DropoutTextBox" 
                                    Grid.Column="1"
                                    Text="0.20" 
                                    Height="35"
                                    FontSize="16"
                                    TextAlignment="Center"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                        
                        <!-- Weight Decay -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Weight Decay" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="L2 regularization strength" 
                                      FontSize="11" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,2,0,8"/>
                            <ComboBox x:Name="WeightDecayComboBox" 
                                     Height="40" 
                                     FontSize="14"
                                     SelectedIndex="2">
                                <ComboBoxItem Content="0 (No regularization)"/>
                                <ComboBoxItem Content="0.00001 (Light)"/>
                                <ComboBoxItem Content="0.0001 (Recommended)"/>
                                <ComboBoxItem Content="0.001 (Strong)"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Checkboxes -->
                        <CheckBox x:Name="DataAugmentationCheckBox" 
                                 Content="Enable Data Augmentation" 
                                 FontSize="14"
                                 IsChecked="True"
                                 Margin="0,0,0,10"/>
                        <CheckBox x:Name="EarlyStoppingCheckBox" 
                                 Content="Enable Early Stopping (patience: 10 epochs)" 
                                 FontSize="14"
                                 IsChecked="True"
                                 Margin="0,0,0,10"/>
                        <CheckBox x:Name="MixedPrecisionCheckBox" 
                                 Content="Mixed Precision Training (FP16, requires GPU)" 
                                 FontSize="14"
                                 IsChecked="False"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Right Panel - Summary & Actions -->
        <Border Grid.Column="1" 
               Background="{StaticResource SurfaceBrush}"
               BorderBrush="{StaticResource BorderBrush}"
               BorderThickness="1,0,0,0"
               Padding="30">
            <StackPanel>
                <TextBlock Text="Configuration Summary" 
                          FontSize="20" 
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,20"/>
                
                <!-- Summary Card -->
                <Border Style="{StaticResource Card}" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                      Text="Epochs:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                      x:Name="SummaryEpochs"
                                      Text="50" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                      Text="Batch Size:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                      x:Name="SummaryBatchSize"
                                      Text="32" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                      Text="Learning Rate:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                      x:Name="SummaryLR"
                                      Text="0.001" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                      Text="Optimizer:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                      x:Name="SummaryOptimizer"
                                      Text="Adam" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                      Text="Augmentation:" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                      x:Name="SummaryAugmentation"
                                      Text="Enabled" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource AccentBrush}"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Estimated Time -->
                <Border Style="{StaticResource Card}" Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="Estimated Training Time" 
                                  FontSize="12" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,5"/>
                        <TextBlock x:Name="EstimatedTimeText"
                                  Text="~15-20 minutes" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="(Based on selected configuration)" 
                                  FontSize="10" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- System Info -->
                <Border Style="{StaticResource Card}" Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="💻 System" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,10"/>
                        <TextBlock x:Name="GPUInfoText"
                                  Text="GPU: Checking..." 
                                  FontSize="11" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,5"/>
                        <TextBlock x:Name="MemoryInfoText"
                                  Text="RAM: Available" 
                                  FontSize="11" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>
                
                <!-- Buttons -->
                <StackPanel Margin="0,30,0,0">
                    <Button Content="← Back" 
                           Height="45"
                           Margin="0,0,0,10"
                           Click="Back_Click"/>
                    <Button Content="🚀 Start Training" 
                           Style="{StaticResource PrimaryButton}"
                           Height="55"
                           FontSize="18"
                           FontWeight="Bold"
                           Click="StartTraining_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

