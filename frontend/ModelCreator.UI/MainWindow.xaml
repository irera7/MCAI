<Window x:Class="ModelCreator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI Model Builder - ساخت مدل هوش مصنوعی" 
        Height="900" 
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Modern Top Navigation Bar with Gradient -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Title with Icon -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center"
                           Margin="32,0,0,0">
                    <Border Background="#FFFFFF" 
                            CornerRadius="8" 
                            Width="40" 
                            Height="40" 
                            Margin="0,0,12,0"
                            Opacity="0.15">
                        <TextBlock Text="🚀" 
                                  FontSize="24" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI Model Builder" 
                                  FontSize="20" 
                                  FontWeight="Bold"
                                  Foreground="White"/>
                        <TextBlock Text="No-Code Machine Learning Platform" 
                                  FontSize="10" 
                                  Foreground="White"
                                  Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Button Content="🏠 Home" 
                           Style="{StaticResource NavButtonStyle}"
                           Click="HomeButton_Click"
                           ToolTip="برگشت به صفحه اصلی"/>
                    
                    <Button Content="📁 Projects" 
                           Style="{StaticResource NavButtonStyle}"
                           Click="ProjectsButton_Click"
                           ToolTip="مشاهده پروژه‌ها"/>
                    
                    <!-- Data Types Menu -->
                    <Button Content="📊 Data Types ▼" 
                           Style="{StaticResource NavButtonStyle}"
                           Click="DataTypesMenu_Click"
                           x:Name="DataTypesButton"
                           ToolTip="انتخاب نوع داده"/>
                    
                    <!-- Features Menu -->
                    <Button Content="🚀 Features ▼" 
                           Style="{StaticResource NavButtonStyle}"
                           Click="FeaturesMenu_Click"
                           x:Name="FeaturesButton"
                           ToolTip="ویژگی‌های پیشرفته"/>
                    
                    <Button Content="❓ Help" 
                           Style="{StaticResource NavButtonStyle}"
                           Click="HelpButton_Click"
                           ToolTip="راهنما و پشتیبانی"/>
                    
                    <Button Content="🔍 Debug" 
                           Style="{StaticResource NavButtonStyle}"
                           Click="DebugButton_Click"
                           ToolTip="ابزار Debug Dashboard"
                           Foreground="#FFD700"/>
                </StackPanel>
                
                <!-- Theme Toggle and Settings -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="0,0,32,0">
                    <Button Content="🌙" 
                           Width="44" 
                           Height="44"
                           FontSize="20"
                           Click="ThemeToggle_Click"
                           Style="{StaticResource NavButtonStyle}"
                           ToolTip="تغییر تم (روشن/تاریک)"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area with Smooth Transitions -->
        <Frame Grid.Row="1" 
               x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>

